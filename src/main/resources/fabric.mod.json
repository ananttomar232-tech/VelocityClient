{
  "schemaVersion": 1,
  "id": "velocity",
  "version": "${version}",
  "name": "Velocity Client",
  "description": "A fast, clean and fun Fabric client: a Feather-style mod menu, drag-and-drop HUD editor, PvP mods and FPS boosters tuned for low-end PCs.",
  "authors": ["Velocity Team"],
  "contact": {
    "sources": "https://github.com/ananttomar232-tech/VelocityClient"
  },
  "license": "MIT",
  "icon": "assets/velocity/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.velocity.client.VelocityClient"
    ]
  },
  "mixins": [
    "velocity.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "recommends": {
    "sodium": "*",
    "lithium": "*",
    "ferritecore": "*"
  }
}
